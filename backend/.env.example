# Database
DATABASE_URL=postgresql://cafe:cafe@localhost:5432/cafeapp

# Server
NODE_ENV=development
PORT=3000
TZ=Asia/Kolkata

# JWT
JWT_ACCESS_SECRET=your-32-byte-access-secret-here-min-32-chars
JWT_REFRESH_SECRET=your-32-byte-refresh-secret-here-min-32-chars-different
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Argon2
ARGON2_MEMORY_KIB=19456

# CORS
CORS_ORIGINS=http://localhost:5173,http://10.0.2.2:3000

# Logging
LOG_LEVEL=info

# QR
QR_TOKEN_BYTES=32
QR_BASE_URL=https://cafeapp.local/t/