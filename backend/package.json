{
  "name": "cafe-app-backend",
  "version": "0.1.0",
  "description": "Backend for CafeApp dine-in ordering",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && prisma generate",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "test": "vitest",
    "lint": "eslint . --ext .ts",
    "health": "node -e \"fetch('http://localhost:3000/api/v1/health').then(r=>r.json()).then(j=>console.log(JSON.stringify(j)))\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.12.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.0.0",
    "tsx": "^4.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
